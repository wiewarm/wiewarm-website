[Unit]
Description=Wiewarm Next.js container
After=network-online.target

[Service]
Environment=WIEWARM_NODE_IMAGE=wiewarm-node:latest
EnvironmentFile=-%h/.config/wiewarm-node-image
ExecStartPre=-/usr/bin/podman rm -f wiewarm-node
ExecStart=/usr/bin/podman run --rm --name wiewarm-node --network host --env-file %h/.wiewarm-node.env --env PORT=3772 --env HOSTNAME=127.0.0.1 --env WIEWARM_API_ORIGIN=http://127.0.0.1:3771 ${WIEWARM_NODE_IMAGE}
ExecStop=/usr/bin/podman stop -t 20 wiewarm-node
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
